@model IEnumerable<CineMatrix.Service.DTO.MovieDto>
@{
    ViewData["Title"] = "My Collection";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Movie Collection</h1>
    <a asp-action="Create" class="btn btn-primary">Add Manual Movie</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @ViewBag.Error
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info text-center p-5">
        <h3>Your collection is empty!</h3>
        <p class="lead">Start by browsing TMDb movies or adding your own.</p>
        <a asp-action="Browse" class="btn btn-primary btn-lg me-2">Browse TMDb</a>
        <a asp-action="Create" class="btn btn-outline-primary btn-lg">Add Manual Movie</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var movie in Model)
        {
            var posterUrl = !string.IsNullOrEmpty(movie.PosterPath)
            ? $"https://image.tmdb.org/t/p/w500{movie.PosterPath}"
            : "https://via.placeholder.com/500x750?text=No+Image";

            <div class="col-md-3">
                <div class="card h-100">
                    <img src="@posterUrl" class="movie-poster" alt="@movie.Title" />
                    <div class="card-body">
                        <h5 class="card-title">@movie.Title</h5>

                        @if (movie.ReleaseDate.HasValue)
                        {
                            <small class="text-muted d-block mb-2">@movie.ReleaseDate.Value.Year</small>
                        }

                        @if (movie.Genres != null && movie.Genres.Any())
                        {
                            <div class="mb-2">
                                @foreach (var genre in movie.Genres.Take(3))
                                {
                                    <span class="genre-badge">@genre.Name</span>
                                }
                            </div>
                        }

                        @if (movie.UserRating.HasValue)
                        {
                            <p class="mb-2 star-rating">★ @movie.UserRating.Value.ToString("0.0")/10</p>
                        }

                        @if (movie.IsInWatchlist)
                        {
                            <span class="badge bg-warning text-dark">Watchlist</span>
                        }
                        @if (movie.IsWatched)
                        {
                            <span class="badge bg-success">Watched</span>
                        }

                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-sm btn-primary w-100">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}