<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineMatrix</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #0d1117;
            color: #c9d1d9;
        }

        .navbar {
            background-color: #161b22 !important;
            border-bottom: 1px solid #30363d;
        }

        .navbar-brand, .nav-link {
            color: #c9d1d9 !important;
        }

            .nav-link:hover {
                color: #58a6ff !important;
            }

        .card {
            background-color: #161b22;
            border: 1px solid #30363d;
            transition: transform 0.2s;
        }

            .card:hover {
                transform: scale(1.05);
                border-color: #58a6ff;
            }

        .card-body {
            color: #c9d1d9;
        }

        .btn-primary {
            background-color: #238636;
            border-color: #238636;
        }

            .btn-primary:hover {
                background-color: #2ea043;
            }

        .movie-poster {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 8px 8px 0 0;
        }

        .genre-badge {
            background-color: #30363d;
            color: #58a6ff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            margin-right: 4px;
        }

        .star-rating {
            color: #fbbf24;
        }

        .search-box {
            background-color: #0d1117;
            border: 1px solid #30363d;
            color: #c9d1d9;
        }

            .search-box:focus {
                border-color: #58a6ff;
                background-color: #0d1117;
                color: #c9d1d9;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    🎬 CineMatrix
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Watchlist">Watchlist</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Watched">Watched</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Browse">Browse TMDb</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Index">My Collection</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Recommendations" asp-action="Index">Recommendations</a>
                        </li>
                    </ul>
                    <form class="d-flex" asp-controller="Movies" asp-action="Search" method="get">
                        <input class="form-control me-2 search-box" type="search" name="query" placeholder="Search movies..." />
                        <button class="btn btn-outline-success" type="submit">Search</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center">
            &copy; 2025 - CineMatrix - Your Personal Movie Tracker
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>