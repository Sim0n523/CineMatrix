@model CineMatrix.Service.DTO.MovieDto
@{
    ViewData["Title"] = "Delete Movie";
    var posterUrl = !string.IsNullOrEmpty(Model.PosterPath)
        ? $"https://image.tmdb.org/t/p/w500{Model.PosterPath}"
        : "https://via.placeholder.com/500x750?text=No+Image";
}

<h1 class="text-danger mb-4">⚠️ Delete Movie</h1>

<div class="alert alert-danger">
    <h4 class="alert-heading">Are you sure you want to delete this movie?</h4>
    <p class="mb-0">This action cannot be undone. All associated ratings and reviews will also be deleted.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <img src="@posterUrl" alt="@Model.Title" class="img-fluid rounded" />
        </div>
    </div>

    <div class="col-md-8">
        <div class="card p-4">
            <h3>@Model.Title</h3>

            @if (Model.ReleaseDate.HasValue)
            {
                <p class="text-muted">Release Date: @Model.ReleaseDate.Value.ToString("MMMM dd, yyyy")</p>
            }

            @if (Model.Genres != null && Model.Genres.Any())
            {
                <div class="mb-3">
                    <strong>Genres:</strong>
                    @foreach (var genre in Model.Genres)
                    {
                        <span class="genre-badge me-1">@genre.Name</span>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Overview))
            {
                <div class="mb-3">
                    <strong>Overview:</strong>
                    <p>@Model.Overview</p>
                </div>
            }

            @if (Model.RuntimeMinutes.HasValue)
            {
                <p><strong>Runtime:</strong> @Model.RuntimeMinutes minutes</p>
            }

            @if (!string.IsNullOrEmpty(Model.Director))
            {
                <p><strong>Director:</strong> @Model.Director</p>
            }

            @if (Model.UserRating.HasValue)
            {
                <div class="alert alert-warning">
                    <strong>Your Rating:</strong> ★ @Model.UserRating.Value.ToString("0.0")/10
                    @if (!string.IsNullOrEmpty(Model.UserReview))
                    {
                        <br />
                        <strong>Your Review:</strong>
                        @Model.UserReview
                    }
                </div>
            }

            @if (Model.TmdbId.HasValue)
            {
                <div class="alert alert-info">
                    <strong>Note:</strong> This is a TMDb movie. Deleting it will remove it from your collection, but you can re-add it anytime from Browse.
                </div>
            }

            <hr class="my-4" />

            <form asp-action="DeleteConfirmed" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="bi bi-trash"></i> Yes, Delete This Movie
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-lg">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .genre-badge {
        background-color: #30363d;
        color: #58a6ff;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        margin-right: 4px;
    }
</style>
