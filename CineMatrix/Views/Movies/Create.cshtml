@model CineMatrix.Service.DTO.CreateMovieDto
@{
    ViewData["Title"] = "Add Manual Movie";
}

<h1 class="mb-4">Add Manual Movie</h1>
<p class="text-muted">Use this form to add movies not found on TMDb (e.g., film festival entries, personal videos, obscure films)</p>

<div class="row">
    <div class="col-md-8">
        <div class="card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Title *</label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Overview" class="form-label">Overview/Description</label>
                    <textarea asp-for="Overview" class="form-control" rows="4"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ReleaseDate" class="form-label">Release Date</label>
                            <input asp-for="ReleaseDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="RuntimeMinutes" class="form-label">Runtime (minutes)</label>
                            <input asp-for="RuntimeMinutes" type="number" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Director" class="form-label">Director</label>
                    <input asp-for="Director" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="PosterPath" class="form-label">Poster URL</label>
                    <input asp-for="PosterPath" class="form-control" placeholder="https://..." />
                    <small class="text-muted">Enter a full URL to an image</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Genres</label>
                    @if (ViewBag.Genres != null)
                    {
                        <div class="row">
                            @foreach (var genre in (List<CineMatrix.Service.DTO.GenreDto>)ViewBag.Genres)
                            {
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="GenreIds" value="@genre.Id" id="genre_@genre.Id" />
                                        <label class="form-check-label" for="genre_@genre.Id">
                                            @genre.Name
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Create Movie</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}