@model IEnumerable<CineMatrix.Service.DTO.MovieDto>
@{
    ViewData["Title"] = "Watchlist";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Watchlist</h1>
    <a asp-action="Browse" class="btn btn-primary">Browse More Movies</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center p-5">
        <h3>Your watchlist is empty!</h3>
        <p class="lead">Add movies you want to watch from TMDb or your collection.</p>
        <a asp-action="Browse" class="btn btn-primary btn-lg">Browse TMDb Movies</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var movie in Model)
        {
            var posterUrl = !string.IsNullOrEmpty(movie.PosterPath)
            ? $"https://image.tmdb.org/t/p/w500{movie.PosterPath}"
            : "https://via.placeholder.com/500x750?text=No+Image";

            <div class="col-md-3">
                <div class="card h-100">
                    <img src="@posterUrl" class="movie-poster" alt="@movie.Title" />
                    <div class="card-body">
                        <h5 class="card-title">@movie.Title</h5>

                        @if (movie.ReleaseDate.HasValue)
                        {
                            <small class="text-muted d-block mb-2">@movie.ReleaseDate.Value.Year</small>
                        }

                        @if (movie.Genres != null && movie.Genres.Any())
                        {
                            <div class="mb-2">
                                @foreach (var genre in movie.Genres.Take(3))
                                {
                                    <span class="genre-badge">@genre.Name</span>
                                }
                            </div>
                        }

                        @if (movie.TmdbRating.HasValue)
                        {
                            <p class="mb-2 star-rating">★ @movie.TmdbRating.Value.ToString("0.0")/10</p>
                        }

                        <div class="mt-3">
                            <form asp-action="MarkAsWatched" method="post" class="mb-2">
                                <input type="hidden" name="id" value="@movie.Id" />
                                <button type="submit" class="btn btn-success btn-sm w-100">✓ Mark as Watched</button>
                            </form>
                            <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-outline-primary btn-sm w-100">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}