@model IEnumerable<CineMatrix.Service.DTO.MovieDto>
@{
    ViewData["Title"] = "Watched Movies";
}

<h1 class="mb-4">Watched Movies</h1>

@if (!Model.Any())
{
    <div class="alert alert-info text-center p-5">
        <h3>You haven't watched any movies yet!</h3>
        <p class="lead">Mark movies from your watchlist as watched and rate them.</p>
        <a asp-action="Watchlist" class="btn btn-primary btn-lg">View Watchlist</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var movie in Model)
        {
            var posterUrl = !string.IsNullOrEmpty(movie.PosterPath)
            ? $"https://image.tmdb.org/t/p/w500{movie.PosterPath}"
            : "https://via.placeholder.com/500x750?text=No+Image";

            <div class="col-md-3">
                <div class="card h-100">
                    <img src="@posterUrl" class="movie-poster" alt="@movie.Title" />
                    <div class="card-body">
                        <h5 class="card-title">@movie.Title</h5>

                        @if (movie.ReleaseDate.HasValue)
                        {
                            <small class="text-muted d-block mb-2">@movie.ReleaseDate.Value.Year</small>
                        }

                        @if (movie.Genres != null && movie.Genres.Any())
                        {
                            <div class="mb-2">
                                @foreach (var genre in movie.Genres.Take(3))
                                {
                                    <span class="genre-badge">@genre.Name</span>
                                }
                            </div>
                        }

                        @if (movie.UserRating.HasValue)
                        {
                            <p class="mb-2 star-rating">★ @movie.UserRating.Value.ToString("0.0")/10</p>
                            @if (!string.IsNullOrEmpty(movie.UserReview))
                            {
                                <p class="text-muted small">@movie.UserReview.Substring(0, Math.Min(50, movie.UserReview.Length))...</p>
                            }
                        }
                        else
                        {
                            <p class="text-warning small">Not rated yet</p>
                        }

                        @if (movie.WatchedDate.HasValue)
                        {
                            <small class="text-muted d-block">Watched: @movie.WatchedDate.Value.ToString("MMM dd, yyyy")</small>
                        }

                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-primary btn-sm w-100">
                                @(movie.UserRating.HasValue ? "View/Edit Rating" : "Add Rating")
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
