@model CineMatrix.Service.DTO.MovieDto
@{
    ViewData["Title"] = Model.Title;
    var posterUrl = !string.IsNullOrEmpty(Model.PosterPath)
        ? $"https://image.tmdb.org/t/p/w500{Model.PosterPath}"
        : "https://via.placeholder.com/500x750?text=No+Image";
    var backdropUrl = !string.IsNullOrEmpty(Model.BackdropPath)
        ? $"https://image.tmdb.org/t/p/original{Model.BackdropPath}"
        : "";
}

@if (!string.IsNullOrEmpty(backdropUrl))
{
    <div class="position-relative mb-4" style="height: 400px; overflow: hidden; border-radius: 12px;">
        <img src="@backdropUrl" alt="@Model.Title" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.3;" />
        <div class="position-absolute top-50 start-50 translate-middle text-center">
            <h1 class="display-3">@Model.Title</h1>
            @if (Model.ReleaseDate.HasValue)
            {
                <p class="lead">(@Model.ReleaseDate.Value.Year)</p>
            }
        </div>
    </div>
}
else
{
    <h1 class="mb-4">@Model.Title</h1>
}

<div class="row">
    <div class="col-md-4">
        <img src="@posterUrl" alt="@Model.Title" class="img-fluid rounded shadow" />

        <!-- Action Buttons -->
        <div class="mt-4">
            @if (!Model.IsInWatchlist && !Model.IsWatched)
            {
                <form asp-action="AddToWatchlistFromDetails" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary w-100 mb-2">📌 Add to Watchlist</button>
                </form>
            }

            @if (Model.IsInWatchlist)
            {
                <form asp-action="MarkAsWatched" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-success w-100 mb-2">✓ Mark as Watched</button>
                </form>
            }

            @if (Model.TmdbId == null)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning w-100 mb-2">Edit Movie</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this movie?');">
                    <button type="submit" class="btn btn-danger w-100">Delete Movie</button>
                </form>
            }
        </div>
    </div>

    <div class="col-md-8">
        <!-- Movie Info -->
        <div class="mb-4">
            @if (Model.Genres != null && Model.Genres.Any())
            {
                <div class="mb-3">
                    @foreach (var genre in Model.Genres)
                    {
                        <span class="genre-badge me-1">@genre.Name</span>
                    }
                </div>
            }

            @if (Model.TmdbRating.HasValue)
            {
                <p class="star-rating fs-4">★ TMDb Rating: @Model.TmdbRating.Value.ToString("0.0")/10</p>
            }

            @if (Model.RuntimeMinutes.HasValue)
            {
                <p><strong>Runtime:</strong> @Model.RuntimeMinutes minutes</p>
            }

            @if (!string.IsNullOrEmpty(Model.Director))
            {
                <p><strong>Director:</strong> @Model.Director</p>
            }

            @if (!string.IsNullOrEmpty(Model.Overview))
            {
                <div class="mt-3">
                    <h4>Overview</h4>
                    <p>@Model.Overview</p>
                </div>
            }
        </div>

        <!-- Rating Section -->
        @if (Model.IsWatched)
        {
            <div class="card p-4 mt-4">
                <h4 class="mb-3">Your Rating & Review</h4>

                @if (Model.UserRating.HasValue)
                {
                    <div class="mb-3">
                        <p class="star-rating fs-3 mb-1">★ @Model.UserRating.Value.ToString("0.0")/10</p>
                        @if (!string.IsNullOrEmpty(Model.UserReview))
                        {
                            <p class="mt-2"><em>"@Model.UserReview"</em></p>
                        }
                        @if (Model.WatchedDate.HasValue)
                        {
                            <small class="text-muted">Watched on @Model.WatchedDate.Value.ToString("MMMM dd, yyyy")</small>
                        }
                    </div>
                }

                <form asp-action="RateMovie" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="movieId" value="@Model.Id" />

                    <div class="mb-3">
                        <label for="score" class="form-label">Rating (0.5 - 5.0)</label>
                        <select name="score" id="score" class="form-select" required>
                            <option value="">Select rating...</option>
                            <option value="1">1 ★</option>
                            <option value="2">2 ★★</option>
                            <option value="3">3 ★★★</option>
                            <option value="4">4 ★★★★</option>
                            <option value="5">5 ★★★★★</option>
                            <option value="6">6 ★★★★★★</option>
                            <option value="7">7 ★★★★★★★</option>
                            <option value="8">8 ★★★★★★★★</option>
                            <option value="9">9 ★★★★★★★★★</option>
                            <option value="10">10 ★★★★★★★★★★</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="review" class="form-label">Review (Optional)</label>
                        <textarea name="review" id="review" class="form-control" rows="4" placeholder="Write your thoughts about this movie...">@Model.UserReview</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        @(Model.UserRating.HasValue ? "Update Rating" : "Submit Rating")
                    </button>
                </form>
            </div>
        }
    </div>
</div>